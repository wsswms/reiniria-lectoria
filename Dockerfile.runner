FROM node@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90 AS dependencies

WORKDIR /app
COPY runner/package.json runner/package-lock.json ./
RUN npm ci --ignore-scripts && npm cache clean --force

FROM node@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

ENV NODE_ENV=production \
    HOME=/tmp/runner-home

WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY runner/package.json runner/package-lock.json ./
COPY src/domain/contracts.mjs ./src/domain/contracts.mjs
COPY src/provider/contracts.mjs ./src/provider/contracts.mjs
COPY src/runner/protocol.mjs ./src/runner/protocol.mjs
COPY src/runner/runner-entry.mjs ./src/runner/runner-entry.mjs
COPY src/runner/boundary-probe.mjs ./src/runner/boundary-probe.mjs

USER 65532:65532

ENTRYPOINT ["node", "--permission", "--allow-fs-read=/app", "--allow-fs-read=/tmp", "--allow-fs-read=/sys/fs/cgroup"]
CMD ["src/runner/runner-entry.mjs"]
