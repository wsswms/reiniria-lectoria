FROM node@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90 AS source

WORKDIR /app
COPY src/http ./src/http
COPY src/runtime ./src/runtime
COPY scripts/m6-http-fixture.mjs ./scripts/m6-http-fixture.mjs

FROM gcr.io/distroless/nodejs22-debian13@sha256:a2723a2817c5b01b8e7b98d567bc8b5a6b0e713e25bfb0a82b6ade4b9db06f50

ENV NODE_ENV=production \
    HOME=/tmp/m6-http-home
WORKDIR /app
COPY --from=source /app/src ./src
COPY --from=source /app/scripts ./scripts
USER 65532:65532
ENTRYPOINT ["/nodejs/bin/node"]
CMD ["scripts/m6-http-fixture.mjs"]
